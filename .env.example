# Скопируйте в .env (уже в .gitignore) и заполните реальными значениями.
# cp .env.example .env

YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
# Опционально: генеративный ответ Yandex Search API (тот же ключ/folder
# выше) — заметно дороже классического поиска, поэтому по умолчанию
# выключен даже при наличии ключа. См. sources/yandex_gen_search.py.
YANDEX_GEN_SEARCH_ENABLED=false
DADATA_API_KEY=
# yandexgpt (боевой провайдер по умолчанию) | cloudru (запасной вариант
# на случай отката с yandexgpt).
LLM_PROVIDER=yandexgpt

# Нужны только при LLM_PROVIDER=yandexgpt — API-ключ Yandex AI Studio
# (studio.yandex.cloud → API-ключи; НЕ тот же ключ, что YANDEX_SEARCH_API_KEY
# выше — это другой сервис Yandex Cloud), ID модели из каталога Yandex AI
# Studio ("yandexgpt" / "yandexgpt-lite" и т.п.).
YANDEX_FM_API_KEY=
YANDEX_FM_MODEL=yandexgpt
# Опционально: если ключ Yandex AI Studio выпущен в ДРУГОМ аккаунте/
# каталоге, чем YANDEX_SEARCH_API_KEY выше — укажите его folder_id явно.
# Если аккаунт один и тот же — не заполняйте, возьмётся YANDEX_FOLDER_ID.
YANDEX_FM_FOLDER_ID=

# Нужны только при LLM_PROVIDER=cloudru — Key Secret из API-ключа,
# выпущенного в карточке модели (Evolution → Foundation Models → модель →
# "Использовать" → создать ключ), + точный ID модели из каталога.
CLOUDRU_API_KEY=
CLOUDRU_MODEL=
